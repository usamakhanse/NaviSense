<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F6FC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:padding="4dp"
            android:text="‹  Find a Friend"
            android:textColor="#123B66"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Navigate to a friend's last recorded QR location."
            android:textColor="#66788D"
            android:textSize="15sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="210dp"
            android:layout_marginTop="20dp"
            android:background="#E2EEFC">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="📍  · · · · ·  📍\n\nFriend Location Illustration"
                android:textColor="#075DBB"
                android:textSize="20sp"
                android:textStyle="bold" />
        </FrameLayout>

        <EditText
            android:id="@+id/etFriendName"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="20dp"
            android:hint="Enter friend name or ID"
            android:inputType="text"
            android:padding="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="🔒 Shared location should only be visible to the intended recipient."
            android:textColor="#66788D"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnTraceFriend"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="22dp"
            android:text="TRACE FRIEND"
            android:textColor="#FFFFFF"
            android:backgroundTint="#075DBB" />

    </LinearLayout>
</ScrollView>